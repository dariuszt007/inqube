<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Inqube Calendar</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <div class="page">
    <header class="topbar">
      <h1>Inqube Calendar</h1>
      <p class="subtitle">Wydarzenia odczytane z repozytorium ictcalendar</p>
    </header>

    <main>
      <section class="panel">
        <div class="panel-head">
          <h2>Lista wydarzeń</h2>
          <button id="reloadBtn" class="btn secondary">Odśwież</button>
        </div>

        <div id="status" class="status">Ładowanie wydarzeń...</div>
        <div id="eventsList" class="events-list"></div>
      </section>
    </main>
  </div>

  <script src="app.js"></script>
</body>
</html>
