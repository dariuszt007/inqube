* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f5f7fb;
  color: #1f2937;
}

.page,
.event-page {
  min-height: 100vh;
}

.topbar {
  background: #111827;
  color: white;
  padding: 24px 20px;
}

.topbar h1 {
  margin: 0 0 8px;
  font-size: 28px;
}

.subtitle {
  margin: 0;
  opacity: 0.9;
}

main,
.event-layout {
  max-width: 1000px;
  margin: 0 auto;
  padding: 20px;
}

.panel,
.detail-card {
  background: white;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  margin-bottom: 20px;
}

.panel-head,
.event-header,
.button-row {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
}

.panel-head h2,
.event-header h1,
.detail-card h3 {
  margin: 0;
}

.status {
  margin: 16px 0;
  padding: 12px 14px;
  background: #eef2ff;
  border-radius: 10px;
  color: #3730a3;
}

.status.small {
  margin-top: 12px;
}

.events-list {
  display: grid;
  gap: 14px;
}

.event-card {
  display: block;
  text-decoration: none;
  color: inherit;
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-left: 10px solid #9ca3af;
  border-radius: 14px;
  padding: 16px;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.event-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
}

.event-card-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}

.event-title {
  font-size: 20px;
  font-weight: bold;
}

.event-date {
  font-size: 14px;
  color: #6b7280;
}

.event-meta {
  display: grid;
  gap: 6px;
  color: #374151;
  font-size: 15px;
}

.btn {
  display: inline-block;
  border: none;
  border-radius: 10px;
  padding: 12px 16px;
  cursor: pointer;
  font-size: 14px;
  text-decoration: none;
  transition: opacity 0.15s ease;
}

.btn:hover {
  opacity: 0.9;
}

.primary {
  background: #2563eb;
  color: white;
}

.secondary {
  background: #e5e7eb;
  color: #111827;
}

.success {
  background: #16a34a;
  color: white;
}

.back-btn {
  background: #111827;
  color: white;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 14px;
  margin-top: 18px;
}

.detail-item {
  background: #f9fafb;
  border-radius: 12px;
  padding: 14px;
}

.label {
  display: block;
  font-size: 13px;
  color: #6b7280;
  margin-bottom: 8px;
}

.memo-input {
  width: 100%;
  min-height: 180px;
  padding: 14px;
  border: 1px solid #d1d5db;
  border-radius: 12px;
  resize: vertical;
  font-size: 15px;
  margin-top: 12px;
}

.json-preview {
  background: #0f172a;
  color: #e2e8f0;
  padding: 16px;
  border-radius: 12px;
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-word;
}

.color-bar {
  width: 100%;
  height: 12px;
  border-radius: 999px;
  margin-bottom: 16px;
  background: #9ca3af;
}

.hint {
  color: #4b5563;
  line-height: 1.5;
}

.hidden {
  display: none;
}

@media (max-width: 640px) {
  .topbar h1 {
    font-size: 24px;
  }

  .event-title {
    font-size: 18px;
  }

  .btn {
    width: 100%;
    text-align: center;
  }

  .button-row {
    flex-direction: column;
    align-items: stretch;
  }
}
